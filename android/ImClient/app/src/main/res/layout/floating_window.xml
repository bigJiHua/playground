<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bubble_other"
    android:elevation="8dp"
    android:padding="6dp">

    <!-- 标题栏：整条可拖动（关闭按钮区域除外） -->
    <LinearLayout
        android:id="@+id/float_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/brand"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- 拖动把手。
             这里必须用 AppCompatImageView + app:tint，不能只用 android:tint：
             浮窗是 Service 侧用 ContextThemeWrapper + LayoutInflater 直接 inflate 的，
             没有 AppCompatActivity 的视图工厂，平台 ImageView 根本不认 app:tint，
             换成 app:tint 会让图标着色静默失效（图标变黑）。 -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/float_grip"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_drag_grip"
            app:tint="@color/on_brand"
            android:contentDescription="@string/float_drag" />

        <TextView
            android:id="@+id/float_title_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/float_title"
            android:textColor="@color/on_brand"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_float_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            app:tint="@color/on_brand"
            android:padding="2dp"
            android:contentDescription="@string/float_close" />
    </LinearLayout>

    <!-- 输入区：输入框与发送按钮同行（原来是上下两行，白占一整行高度）。
         浮窗面积小，纵向空间必须留给消息列表。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <EditText
            android:id="@+id/et_float_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:hint="@string/float_hint"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:maxLines="1"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_float_send"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:minWidth="56dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/float_send"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
