<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 悬浮窗（全局覆盖其他应用） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务（保持 WebSocket 长连接） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 前台服务 dataSync 类型必需（缺失会导致启动 FGS 抛 SecurityException 闪退） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 前台服务通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 通知震动需要：没有它 enableVibration(true) 静默失效 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 安装聊天里收到的 APK 安装包（Android 8+ 需要） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 把下载的文件存到公开 Download/ImClient（文件管理器根目录可见，Android 11+ 需要此权限） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ImClient"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 聊天 + 悬浮窗前台服务（dataSync 类型，Android 14 需 FOREGROUND_SERVICE_DATA_SYNC 权限） -->
        <service
            android:name=".ChatService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 接收 APK 安装结果（PackageInstaller 会话提交回调）。
             PendingIntent 是本应用创建的、由本应用身份发出，所以不需要对外暴露。 -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <!-- 文件分享（点击文件消息后用系统应用打开） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

    <!-- Android 11(API 30)+ 包可见性：不声明这些 intent，queryIntentActivities /
         resolveActivity 查不到系统安装器（返回空/null），代码会误判成"没有安装权限"
         或"未找到安装程序"，MIUI / ColorOS 上表现为点了安装毫无反应。
         这是 targetSdk 30+ 的硬性要求，必须列出来才能把 APK 交给安装器。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

</manifest>
